{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "gmail": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "gws-mcp-server",
        "--services",
        "gmail"
      ],
      "env": {}
    },
    "typecast": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/neosapience/typecast-api-mcp-server.git",
        "typecast-api-mcp-server"
      ],
      "env": {
        "TYPECAST_API_KEY": "${TYPECAST_API_KEY}",
        "TYPECAST_OUTPUT_DIR": "${TYPECAST_OUTPUT_DIR:-output/typecast}"
      }
    }
  }
}